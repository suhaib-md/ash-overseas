{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ash-overseas",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-07",
  "compatibility_flags": ["nodejs_compat"],

  // Serve the React SPA as static assets. Only /api/* invokes the Worker first;
  // every other path falls back to index.html (client-side routing).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "observability": { "enabled": true },

  // --- DEV database (default env, used by `vite dev` and `wrangler dev`) ---
  // `pnpm dev` uses a LOCAL emulated copy of this DB; the id is used for remote dev.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ash-overseas-dev",
      "database_id": "8c7cd9dd-8c53-4f63-b830-b4ffc2d42c1f",
      "migrations_dir": "migrations",
    },
  ],

  // R2 bucket for off-store SQL-dump backups. Create it before deploying:
  // enable R2 in the dashboard, then `wrangler r2 bucket create ash-overseas-backups`.
  // Local dev uses an emulated bucket automatically.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "ash-overseas-backups" }],

  // --- PRODUCTION env: `wrangler deploy --env production` ---
  "env": {
    "production": {
      "name": "ash-overseas-prod",
      "observability": { "enabled": true },
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ash-overseas-prod",
          "database_id": "7385f774-9204-4cbd-9527-a0b27fc9178b",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "ash-overseas-backups" }],
      // Nightly backup to R2 (00:00 IST ≈ 18:30 UTC).
      "triggers": { "crons": ["30 18 * * *"] },
    },
  },
}
